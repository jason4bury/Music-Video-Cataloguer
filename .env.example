# Music Video Cataloguer settings. Copy this file to .env, fill in the values, then run:
#   docker compose up -d
# .env holds your real password: it is gitignored, so never commit it.

# Port on the host: the app is at http://<your-server>:PORT
PORT=3001

# Docker image tag to run (latest, or a version such as 1.00)
MUSIC_VIDEO_CATALOGUER_TAG=latest

# --- Folders on THIS machine (the Docker host) ---
# Your music videos, one subfolder per artist, e.g.
#   D:/Music Videos/Daft Punk/Daft Punk - Around the World.mp4
LIBRARY_HOST_DIR=D:/Music Videos

# Optional: a host folder for the database and thumbnails, e.g.
#   DATA_HOST_DIR=E:/Docker/music-video-cataloguer
# Leave blank to use a named Docker volume (music-video-cataloguer-data) instead.
DATA_HOST_DIR=

# How often (minutes) to rescan the library automatically; 0 turns it off
SCAN_INTERVAL_MINUTES=60

# --- Sign-in ---
# The account always matches these: change them here and restart to change them in the app.
# Leave AUTH_PASSWORD blank to have a password generated on the very first start and printed
# once to `docker compose logs`. Example passwords such as "changeme" are refused.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Optional: a random string of 32+ characters that signs session cookies. Leave blank and one is
# generated and kept in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# true if the app sits behind a reverse proxy (Nginx Proxy Manager, Caddy, Traefik...), so the
# sign-in lockout counts wrong passwords per real client rather than per proxy.
TRUST_PROXY=false

# --- Running without Docker (npm start) ---
# Set LIBRARY_PATH and DATA_DIR to real folders on this machine instead, e.g.
#   LIBRARY_PATH=D:/Music Videos
#   DATA_DIR=./data
# and install ffmpeg so ffmpeg and ffprobe are on the PATH. The *_HOST_DIR and *_TAG settings
# above are then ignored.
