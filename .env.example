# Music Video Cataloguer settings. Copy this file to .env next to docker-compose.yml and fill in
# the values. Your music video folder is set in docker-compose.yml, not here.
# .env holds your real password: it is gitignored, so never commit it.

# How often (minutes) to rescan the library automatically; 0 turns it off
SCAN_INTERVAL_MINUTES=60

# Sign-in. The account always matches these: change them here and restart to change them in
# the app. Leave AUTH_PASSWORD blank to have a password generated on the very first start and
# printed once to `docker compose logs`. Example passwords such as "changeme" are refused.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Optional: a random string of 32+ characters that signs session cookies. Leave blank and one is
# generated and kept in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or: openssl rand -hex 32
SESSION_SECRET=

# true if the app sits behind a reverse proxy (Nginx Proxy Manager, Caddy, Traefik...), so the
# sign-in lockout counts wrong passwords per real client rather than per proxy.
TRUST_PROXY=false

# --- Running without Docker (npm start) ---
# Set LIBRARY_PATH and DATA_DIR to real folders on this machine, e.g.
#   LIBRARY_PATH=D:/Music Videos
#   DATA_DIR=./data
# and install ffmpeg so ffmpeg and ffprobe are on the PATH. It listens on port 3211 unless PORT
# is set.
